{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "progressiveDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiServerCIDR": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/32$"
        },
        "backendsEnabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "apiServerCIDR"
            ]
          }
        }
      ]
    }
  }
}
