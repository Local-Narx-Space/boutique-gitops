{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "progressiveDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiServerCIDR": {
          "type": "string",
          "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/32|172\\.18\\.0\\.0/16)$"
        },
        "backendsEnabled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "apiServerCIDR"
            ]
          }
        }
      ]
    },
    "frontendAutoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
