{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "key_id",
    "payload",
    "signature"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "service",
        "image",
        "source_commit",
        "build_url",
        "tests_passed",
        "security_gate_passed",
        "sbom_sha256",
        "scan_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "service": {
          "enum": [
            "frontend",
            "catalogue",
            "cart",
            "orders",
            "incident-bridge"
          ]
        },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/subhankar12-spec/boutique-(frontend|catalogue|cart|orders|incident-bridge)@sha256:[a-f0-9]{64}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build_url": {
          "type": "string",
          "format": "uri"
        },
        "tests_passed": {
          "const": true
        },
        "security_gate_passed": {
          "const": true
        },
        "sbom_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/subhankar12-spec/boutique-gitops/schemas/release-attestation.schema.json",
  "title": "Boutique signed release quality attestation",
  "description": "Protected-main release job attestation; verify its signature with scripts/release_attestation.py."
}
