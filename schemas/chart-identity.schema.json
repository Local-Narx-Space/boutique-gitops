{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "repository",
    "version",
    "package_sha256"
  ],
  "properties": {
    "name": {
      "enum": [
        "boutique-frontend",
        "boutique-catalogue",
        "boutique-cart",
        "boutique-orders"
      ]
    },
    "repository": {
      "const": "oci://ghcr.io/subhankar12-spec/charts"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.0-(bootstrap|[a-f0-9]{40})$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$id": "https://github.com/subhankar12-spec/boutique-gitops/schemas/chart-identity.schema.json"
}
