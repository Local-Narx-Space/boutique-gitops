{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/subhankar12-spec/boutique-gitops/schemas/delivery-record.schema.json",
  "title": "Boutique GitOps reviewed delivery record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "service",
    "environment",
    "image",
    "previous_image",
    "release",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "enum": [
        "promote",
        "rollback"
      ]
    },
    "service": {
      "enum": [
        "frontend",
        "catalogue",
        "cart",
        "orders"
      ]
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^ghcr\\.io/subhankar12-spec/boutique-(frontend|catalogue|cart|orders)@sha256:[a-f0-9]{64}$"
    },
    "previous_image": {
      "type": "string"
    },
    "release": {
      "$ref": "release-attestation.schema.json"
    },
    "verification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "release-evidence.schema.json"
        }
      ]
    }
  },
  "description": "Schema validates shape only. Use protected scripts/check_delivery_change.py for trust, freshness and base-history policy."
}
