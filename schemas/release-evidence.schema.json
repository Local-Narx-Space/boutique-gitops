{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "key_id",
    "payload",
    "signature"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "service",
        "environment",
        "image",
        "gitops_commit",
        "verified_at",
        "build_url",
        "deployment",
        "runtime",
        "argocd",
        "smoke"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "service": {
          "enum": [
            "frontend",
            "catalogue",
            "cart",
            "orders"
          ]
        },
        "environment": {
          "enum": [
            "dev",
            "staging",
            "production"
          ]
        },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/subhankar12-spec/boutique-(frontend|catalogue|cart|orders)@sha256:[a-f0-9]{64}$"
        },
        "gitops_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "build_url": {
          "type": "string",
          "format": "uri"
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "generation",
            "observed_generation",
            "desired_replicas",
            "updated_replicas",
            "ready_replicas",
            "available_replicas",
            "available",
            "progressing"
          ],
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^ghcr\\.io/subhankar12-spec/boutique-(frontend|catalogue|cart|orders)@sha256:[a-f0-9]{64}$"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "observed_generation": {
              "type": "integer",
              "minimum": 1
            },
            "desired_replicas": {
              "type": "integer",
              "minimum": 1
            },
            "updated_replicas": {
              "type": "integer",
              "minimum": 0
            },
            "ready_replicas": {
              "type": "integer",
              "minimum": 0
            },
            "available_replicas": {
              "type": "integer",
              "minimum": 0
            },
            "available": {
              "const": true
            },
            "progressing": {
              "const": true
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready_pods",
            "image_ids"
          ],
          "properties": {
            "ready_pods": {
              "type": "integer",
              "minimum": 1
            },
            "image_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "(@|^)sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "sync_status",
            "health_status"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "sync_status": {
              "const": "Synced"
            },
            "health_status": {
              "const": "Healthy"
            }
          }
        },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "environment",
            "origin",
            "started_at",
            "completed_at",
            "success",
            "checks"
          ],
          "properties": {
            "schema_version": {
              "const": 1,
              "type": "integer"
            },
            "environment": {
              "enum": [
                "dev",
                "staging",
                "production"
              ]
            },
            "origin": {
              "type": "string",
              "format": "uri"
            },
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|\\+00:00)$"
            },
            "success": {
              "const": true
            },
            "checks": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "browse",
                  "cart",
                  "validation",
                  "origin",
                  "session_isolation",
                  "server_pricing",
                  "checkout",
                  "repeat_idempotency",
                  "concurrent_idempotency",
                  "order_ownership",
                  "empty_cart",
                  "deletion"
                ]
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/subhankar12-spec/boutique-gitops/schemas/release-evidence.schema.json",
  "title": "Boutique signed deployment verification evidence",
  "description": "Shape validation only. Cryptographic trust, exact digest, rollout counts, freshness and Git history require scripts/evidence.py."
}
