{
  "uid": "boutique-overview",
  "title": "Boutique operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=~\"boutique|orders\"}, environment)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Service availability",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "min by(service,environment) (up{job=~\"boutique|orders\",environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:requests:rate5m{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:errors:rate5m{environment=~\"$environment\"} / boutique:requests:rate5m{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p95 seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:latency:p95{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pending incidents",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:incident:pending",
          "refId": "A",
          "legendFormat": "{{cluster}} {{environment}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Oldest incident seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:incident:oldest_seconds",
          "refId": "A",
          "legendFormat": "{{cluster}} {{environment}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM heap bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Frontend heap bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique_node_heap_bytes",
          "refId": "A",
          "legendFormat": "{{service}} {{environment}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Application logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{environment=~\"$environment\",service=~\"frontend|catalogue|cart|orders\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Incident dead letters",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique:incident:dead_letters",
          "refId": "A",
          "legendFormat": "{{cluster}} {{environment}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Incident worker heartbeat age seconds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boutique_incident_worker_heartbeat_age_seconds{job=\"incident-bridge\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} {{pod}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Incident bridge scrape availability",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"incident-bridge\"}",
          "refId": "A",
          "legendFormat": "{{cluster}} {{pod}}"
        }
      ]
    }
  ]
}
