{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "applicationNamespaces",
    "alloy",
    "incidentBridge",
    "lab"
  ],
  "properties": {
    "profile": {
      "enum": [
        "base",
        "homelab",
        "nonprod",
        "production"
      ]
    },
    "applicationNamespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "boutique-dev",
          "boutique-staging",
          "boutique-production"
        ]
      }
    },
    "alloy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "spec"
      ],
      "properties": {
        "cluster": {
          "enum": [
            "homelab",
            "nonprod",
            "production"
          ]
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "incidentBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "spec",
        "enabled"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "digest"
          ],
          "properties": {
            "repository": {
              "const": "ghcr.io/subhankar12-spec/boutique-incident-bridge"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "anyOf": [
            {
              "properties": {
                "digest": {
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "tag": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "digest": {
                  "const": ""
                },
                "tag": {
                  "enum": [
                    "bootstrap",
                    "replace-with-tested-digest"
                  ]
                }
              }
            }
          ]
        },
        "spec": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "grafanaIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "host"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kubernetesApiEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cidr",
        "port"
      ],
      "properties": {
        "cidr": {
          "type": "string",
          "pattern": "^[0-9.]+/32$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lab": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "profile": {
            "enum": [
              "nonprod",
              "production"
            ]
          }
        }
      }
    }
  ]
}
